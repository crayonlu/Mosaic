{
  "name": "mosaic-workspace",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "mobile",
    "server/admin-ui"
  ],
  "description": "Mosaic - Mobile (React Native) workspace",
  "scripts": {
    "mobile:start": "bun --filter @mosaic/mobile start",
    "mobile:android": "bun --filter @mosaic/mobile android",
    "mobile:ios": "bun --filter @mosaic/mobile ios",
    "mobile:web": "bun --filter @mosaic/mobile web",
    "build:sync": "bun --filter @mosaic/sync build",
    "build:mcp": "bun --filter mosaic-mcp build",
    "mcp:start": "bun --filter mosaic-mcp start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "format": "turbo run format",
    "format:force": "turbo run format --force",
    "format:check": "turbo run format:check",
    "check": "turbo run lint typecheck format:check",
    "check:force": "turbo run lint typecheck format:check --force",
    "prepare": "husky"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "overrides": {
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "expo": "~58.0.17"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crayonlu/Mosaic.git"
  },
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0"
  },
  "devDependencies": {
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "turbo": "^2.9.14"
  },
  "patchedDependencies": {
    "react-native-draggable-grid@2.2.2": "patches/react-native-draggable-grid@2.2.2.patch",
    "@react-native-masked-view/masked-view@0.3.2": "patches/@react-native-masked-view%2Fmasked-view@0.3.2.patch"
  }
}
