# Mosaic Go server configuration.
# Copy to .env for local development.

# Required
DATABASE_URL=postgres://mosaic_user:mosaic_password@localhost:5432/mosaic
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ADMIN_PASSWORD=admin123

# Network
PORT=8080
# Comma-separated. When empty, CORS allows any origin (development only).
# ALLOWED_ORIGINS=https://app.example.com

# Storage
# Options: "local" or "r2"
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bootstrap admin account
ADMIN_USERNAME=admin

# Media processing
FFMPEG_BINARY=ffmpeg

# External services
HTML2LLM_URL=https://html2llm.cyncyn.xyz

# Migrations
MIGRATIONS_DIR=./migrations
